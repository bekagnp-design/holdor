diff --git a/src/mod/home150.css b/src/mod/home150.css
new file mode 100644
index 0000000..fb96cf6
--- /dev/null
+++ b/src/mod/home150.css
@@ -0,0 +1,77 @@
+/* v1.5.0: the home answers three questions — what is ready, what to do now, what is new (src/mod/home150.js).
+   One rhythm: 8 px between pieces, 12 px inside, 16 px radii; body ≥ 13 px, captions ≥ 11 px, tap targets ≥ 44 px. */
+.hubbody.battle{padding:6px 10px 10px}
+/* WHAT IS READY: gold pills on dark, only when something is */
+.hmready{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 8px}
+.hmready .rdy{flex:1 1 calc(50% - 4px);min-width:0;min-height:44px;display:flex;align-items:center;gap:8px;padding:6px 10px 6px 8px;border-radius:14px;border:2px solid #e9b949;background:linear-gradient(180deg,rgba(60,40,8,.78),rgba(28,20,6,.86));color:#ffe8a8;text-align:left;box-shadow:0 3px 0 #5a3a10,0 0 14px rgba(255,214,100,.28)}
+.hmready .rdy i{font-style:normal;font-size:20px;line-height:1;flex:0 0 24px;display:flex;align-items:center;justify-content:center;color:#8be26a}
+.hmready .rdy i svg{width:22px;height:22px;filter:drop-shadow(0 1px 0 rgba(0,0,0,.5))}
+.hmready .rdy b{flex:1;min-width:0;font-family:var(--f-display);font-size:13px;letter-spacing:.02em;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-shadow:0 1px 0 rgba(0,0,0,.6)}
+.hmready .rdy em{font-style:normal;font-weight:900;font-size:18px;line-height:1;opacity:.75}
+.hmready .rdy.champ,.hmready .rdy.tower{border-color:#7fd06a;color:#dfffd3;box-shadow:0 3px 0 #1e5a1c,0 0 14px rgba(120,230,100,.25)}
+.hmready .rdy.champ i,.hmready .rdy.tower i{color:#8be26a;font-weight:900}
+/* the stage: the art, the 🎨 in the corner, the road-north bar at the foot */
+.hmstage{margin:0 -2px 8px;min-height:200px}
+.hmskin{position:absolute;right:8px;top:8px;z-index:5;width:36px;height:36px;border-radius:50%;border:2px solid rgba(255,255,255,.22);background:rgba(0,0,0,.38);font-size:16px;line-height:1;padding:0;opacity:.8}
+.hmskin::before{content:'';position:absolute;inset:-5px}
+.hmgoal.v150{left:8px;right:8px;bottom:8px;min-height:40px;padding:5px 12px;gap:10px;border-radius:12px;border-color:rgba(255,255,255,.14);background:linear-gradient(90deg,rgba(0,0,0,.66),rgba(0,0,0,.42))}
+.hmgoal.v150 .gl{flex:1;min-width:0;gap:2px}.hmgoal.v150 .gl small{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#9fe0ff}
+.hmgoal.v150 .gl b{font-size:13px;font-weight:700}
+.hmgoal.v150 .gp{flex:0 0 72px;height:8px;border-radius:4px}.hmgoal.v150 .gp i{border-radius:4px}
+.hmgoal.v150 .gs{font-size:12px;letter-spacing:0;color:#ffe08a;font-weight:800;white-space:nowrap}
+.hmgoal.v150 .arr{font-style:normal;font-size:16px;font-weight:900;color:#cfe6ff;opacity:.8}
+/* WHAT DO I DO NOW: one green button, straight under the art */
+.battlerow.v150{margin:0 0 8px}
+.bbig.go150{display:flex;align-items:center;gap:10px;min-height:72px;padding:8px 12px 8px 10px;text-align:left;border-radius:18px;border:3px solid #1e5a1c;border-bottom:8px solid #1e5a1c;color:#fff;letter-spacing:.04em;font-size:24px;
+  background:linear-gradient(180deg,#9aea78 0%,#5cbd4c 50%,#3f9a3a 100%);text-shadow:0 2px 0 rgba(0,0,0,.45);box-shadow:inset 0 3px 0 rgba(255,255,255,.45),0 10px 16px rgba(0,0,0,.35),0 0 24px rgba(120,230,100,.3)}
+.bbig.go150 .bbi{flex:0 0 46px;width:46px;height:46px;border-radius:12px;background:rgba(0,0,0,.26);display:flex;align-items:center;justify-content:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.15)}
+.bbig.go150 .bbi svg{width:32px;height:32px;filter:drop-shadow(0 2px 0 rgba(0,0,0,.4))}
+.bbig.go150 .bbt{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;line-height:1}
+.bbig.go150 .bbt b{font-size:24px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.bbig.go150 .bbt small,.bbig.go150 .bbr small{display:block;margin:0;font-size:12px;letter-spacing:.06em;font-weight:800;color:#eaffe0;text-shadow:0 1px 0 rgba(0,0,0,.5);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.bbig.go150 .bbr{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;gap:4px;line-height:1}
+.bbig.go150 .bbr em{font-style:normal;font-size:15px;font-weight:900;color:#fff3b0;letter-spacing:.02em}
+.bbig.go150 .bbr small{color:#ffe08a;letter-spacing:0}.bbig.go150 .bbr small i{font-style:normal;color:rgba(255,255,255,.35)}
+.bbig.go150.pulse{animation:go150Pulse 1.6s ease-in-out infinite}
+@keyframes go150Pulse{0%,100%{box-shadow:inset 0 3px 0 rgba(255,255,255,.45),0 10px 16px rgba(0,0,0,.35)}50%{box-shadow:inset 0 3px 0 rgba(255,255,255,.45),0 10px 16px rgba(0,0,0,.35),0 0 0 5px rgba(170,255,140,.5),0 0 30px rgba(120,230,100,.8)}}
+html.fxui .battlerow.v150 .fxglow{border-radius:20px;box-shadow:0 0 16px 5px rgba(140,230,110,.7),0 0 34px 10px rgba(80,180,70,.35)}
+/* the quiet row under it: Map · what opens next · the champion */
+.hmside{display:flex;gap:8px;margin:0 0 8px;align-items:stretch}
+.hmside .bside{flex:0 0 64px;height:52px;padding:3px 2px;gap:1px;line-height:1;border-radius:14px;border:2px solid rgba(255,255,255,.14);border-bottom-width:4px;background:rgba(10,24,48,.55);box-shadow:none;font-size:11px;position:relative;text-shadow:0 1px 0 rgba(0,0,0,.6)}
+.hmside .bside img{width:26px;height:26px;border-radius:8px}.hmside .bside .pe{font-size:21px;line-height:1}
+.hmside .bside .upb{position:absolute;top:-7px;right:-7px;width:22px;height:22px;border-radius:50%;background:linear-gradient(180deg,#8be26a,#3f9a3a);border:2px solid #fff;color:#0b2a0a;font-style:normal;font-size:13px;line-height:18px;text-align:center;text-shadow:none;z-index:2}
+.hmnew{flex:1;min-width:0;height:52px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:3px;padding:6px 12px;border-radius:14px;border:2px solid rgba(255,255,255,.14);border-bottom-width:4px;background:rgba(10,24,48,.55);color:#fff;text-align:left;font-family:var(--f-body)}
+.hmnew small{font-size:11px;letter-spacing:.12em;font-weight:800;color:#9fe0ff;text-transform:uppercase;line-height:1}
+.hmnew b{font-family:var(--f-display);font-size:13px;line-height:1.1;display:flex;align-items:center;gap:6px;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.hmnew b .ni{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;flex:0 0 auto;font-size:16px;font-family:var(--f-body)}
+.hmnew b .ni svg,.hmnew b .ni img{width:22px;height:22px}
+.hmnew.done small{color:#ffe08a}
+.hub.g-noarmy .hmside{justify-content:center}
+/* the chests: a label on each, the ready ones lit, the rest quiet */
+.hmslots.top{gap:8px;margin:0 0 8px}
+.hmslots.top .slot{aspect-ratio:auto;height:96px;padding:6px 2px 6px;justify-content:space-between}
+.slot .sl{position:relative;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#bcd3ee;line-height:1;font-family:var(--f-body)}
+.slot.ready .sl{color:#ffe08a}
+.slot:not(.ready) .si{opacity:.82}
+.slot em{font-size:11px;padding:2px 7px;letter-spacing:.03em}
+.slot .si.gift svg{width:34px;height:34px}
+/* the Hold steps back: a quiet card, a blue button */
+.hmhold{margin:0 0 8px;border-width:2px;border-color:rgba(255,255,255,.14);background:linear-gradient(90deg,rgba(29,79,138,.55),rgba(18,58,107,.55));box-shadow:0 3px 0 rgba(0,0,0,.35)}
+.hmhold .hmrow{padding:8px 10px 6px;gap:12px}.hmhold .hmtx{gap:0}
+.hmhold .hmtx b{font-size:13px;color:#dfe9f7;text-shadow:0 1px 0 rgba(0,0,0,.6)}
+.hmhold .hmtx small,.hmhold .hmtx em{font-size:11px}.hmhold .hmcd{font-size:11px}
+.hmhold .hmgo{min-width:72px;min-height:48px;padding:6px 8px;font-size:14px;border-width:2px;border-color:rgba(255,255,255,.14);background:rgba(0,0,0,.3);box-shadow:none;color:#bcd3ee}
+.hmhold .hmgo small{font-size:9.5px}
+.hmhold .hmgo.go{background:linear-gradient(180deg,#5aa0ff,#2f63c7);color:#fff;border-color:#163a7a;box-shadow:0 3px 0 #163a7a;animation:none}
+.hmhold .hmlink{min-height:32px;font-size:12px;padding:6px 12px}
+/* the strip: rank · Tasks · the event, quiet, at the bottom */
+.hmstrip.low{margin:0 0 2px;gap:8px}
+.hmstrip.low .hpill{height:36px;padding:0 12px 0 9px;border-radius:20px;background:rgba(10,24,48,.55);border:2px solid rgba(255,255,255,.14);box-shadow:none;color:#dfe9f7;font-size:12px;position:relative}
+.hmstrip.low .hpill::before{content:'';position:absolute;inset:-3px}
+.hmstrip.low .hpill b{font-size:13px}.hmstrip.low .hpill small{font-size:11px;color:#bcd3ee}.hmstrip.low .hpill em{font-size:11px}
+.hmstrip.low .hpill.hot{border-color:#e9b949}.hmstrip.low .hpill.hot b{color:#ffe08a}
+.hmstrip.low .hpill.ev.on{background:linear-gradient(90deg,#6a2f0c,#a3531a);border-color:#3a1806}
+.hubtabs.four button{font-size:11px}
+/* short phones: the button stays in the first screen */
+@media (max-height:700px){.hmstage{min-height:140px}.bbig.go150{min-height:64px}.bbig.go150 .bbt b{font-size:22px}.hmslots.top .slot{height:86px}.hmside .bside,.hmnew{height:48px}.hmstrip.low .hpill{height:34px}}
+@media (prefers-reduced-motion:reduce){.bbig.go150.pulse{animation:none}}
diff --git a/src/mod/home150.js b/src/mod/home150.js
new file mode 100644
index 0000000..e2b6f3b
--- /dev/null
+++ b/src/mod/home150.js
@@ -0,0 +1,87 @@
+/* =========================== THE HOME ANSWERS THREE QUESTIONS (v1.5.0) ===========================
+   A tester with the phone in hand: "two gold buttons, which one?" So the first screen now answers, top to bottom:
+     WHAT IS READY  — a row of gold pills, only when something is: chests to open, gifts to claim, a champion or a tower that can
+                      level up. Nothing ready → no row.
+     WHAT DO I DO NOW — one green button straight under the stage art: BATTLE · STAGE 7 · its name · the gold it pays. One tap goes
+                      to the preparation sheet (or straight into the stage): the map stays one tap away on the Map button and the
+                      road-north bar on the art.
+     WHAT IS NEW    — a quiet pill between Map and the champion: the next thing that opens and at which stage (tower, spell,
+                      champion, the Hold, Trials, Kingsguard). Tap: its room.
+   Everything else steps back: the chests under the button with a label each (Stars · Level · Free · Gift), the Hold card in quiet
+   blue, the rank / Tasks / event pills at the bottom with lower contrast. The three looks are back behind a small 🎨 in the art's
+   corner (A hero stage · B living gate · C war map; skins.js draws them). Injected last: hubHome / homeStrip / homeSlots / homeGoal /
+   homeBattleRow / skinOf / skinNext here replace the earlier ones; homeBind is wrapped. The ids the coach and the tests know stay:
+   #bBattle, #bMapH / #bDiffH, #bChampH, #hmGoal, #hmStage, #bSkin, .hmslots .slot (#starChest #lvlChest #lvlNext #freeChest
+   #dailyGift), #hmHold / #bHold / #bHoldMore, .hmstrip (#hubTro #bTasks #evBadge). New: #hmReady .rdy[data-r], #hmNew. */
+function skinOf(){try{const u=new URLSearchParams(location.search).get('skin');if(u&&SKINS[u]&&!HOME.urlDone){HOME.urlDone=1;localStorage.setItem('holdor_skin',u);}
+  const k=localStorage.getItem('holdor_skin');return SKINS[k]?k:'b';}catch(e){return 'b';}}
+function skinNext(){const o=['a','b','c'],k=o[(o.indexOf(skinOf())+1)%3];skinSet(k);ecoToast(`${SKINS[k].e} ${SKINS[k].n} · ${o.indexOf(k)+1} / 3`,true);}
+/* ---------- what is ready ---------- */
+function homeReadyItems(n){const out=[];if(!ACC||!ACC.tut)return out;
+  if(n>=1){const d=dailyOn()?(DAILY.st&&DAILY.seat===seatNo()?DAILY.st.login:null):null;
+    const ch=Math.max(0,starChestsReady())+lvlChestsReady()+(freeChestReady()?1:0)+(d&&d.can?1:0);
+    if(ch)out.push({k:'chest',e:icon('gift',22),t:`${ch} ${ch===1?'chest':'chests'} to open`,go:()=>{const s=document.querySelector('.hmslots .slot.ready');if(s)s.click();}});}
+  if(n>=2){const tk=typeof tasksReady==='function'?tasksReady():0;if(tk)out.push({k:'task',e:icon('quests',22),t:`${tk} ${tk===1?'gift':'gifts'} to claim`,go:()=>showHub('tasks')});}
+  if(!hubLocked('coll')&&typeof cardCan==='function'){const c=CBY[ACC.sel];
+    if(c&&cardCan('c:'+c.id))out.push({k:'champ',e:'⬆',t:`${shortName(c)} can level up`,go:()=>showHeroRoom(c.id)});
+    const tw=TKEYS.filter(t=>towerOpen(t)&&cardCan('t:'+t));
+    if(tw.length)out.push({k:'tower',e:'⬆',t:tw.length===1?`${TSHORT[tw[0]]||TOWERS[tw[0]].n} can level up`:`${tw.length} towers can level up`,go:()=>showTowerRoom(tw[0])});}
+  return out;}
+function homeReadyRow(n){const it=homeReadyItems(n);if(!it.length)return '';
+  return `<div class="hmready" id="hmReady">${it.map(i=>`<button class="rdy ${i.k}" data-r="${i.k}"><i>${i.e}</i><b>${esc(i.t)}</b><em>›</em></button>`).join('')}</div>`;}
+/* ---------- what is new: the next thing that opens ---------- */
+function homeNextOpen(){const n=cleared(),sv=ACC.sv?3:0,out=[];
+  for(const k in OB_NEED)if(hubLocked(k))out.push({at:OB_NEED[k]+sv,e:k==='coll'?'🛡️':k==='shop'?HUB_ICON.shop:HUB_ICON.trials||'🌙',n:k==='coll'?'The Army':k==='shop'?'The Shop':'Trials',go:()=>hubLockSay(k)});
+  if(!onlineOpen())out.push({at:ONLINE_AT,e:icon('door',22),n:'The Hold · one map a day',go:()=>ecoToast(`🔒 The Hold opens after stage ${ONLINE_AT}`)});
+  for(const k of TKEYS)if(!towerOpen(k))out.push({at:TOWER_UNLOCK[k],e:towerIconHTML(k,1,22),n:(TSHORT[k]||TOWERS[k].n)+' tower',go:()=>showTowerRoom(k)});
+  for(const k in SPELLS)if(SPELLS[k].at>n)out.push({at:SPELLS[k].at,e:spellSVG(k),n:SPELLS[k].n+' spell',go:()=>showSpellRoom(k)});
+  for(const c of CHAMPS)if(c.house===ACC.house&&!unlocked(null,c))out.push({at:UNLOCK_STAGE[c.tier],e:c.e||'🛡️',n:shortName(c)+' joins',go:()=>showHeroRoom(c.id)});
+  if(typeof hardOpen==='function'&&!hardOpen())out.push({at:LEVELS.length,e:DIFFS.kingsguard.e,n:'Kingsguard difficulty',go:()=>showDifficulty(false)});
+  out.sort((a,b)=>a.at-b.at);return out.find(x=>x.at>n)||null;}
+/* ---------- the pieces ---------- */
+function homeStrip(){const n=obStage(),R=myRank(),e=evAt(Date.now()),K=EVT_KIND[e.kind],left=e.active?e.t1-Date.now():e.t0-Date.now(),tk=typeof tasksReady==='function'?tasksReady():0;
+  return `<div class="hmstrip low"><button class="hpill" id="hubTro">${rankSVG(R.t,20,R.div)}<b>${trophiesOf()}</b><small>rank</small></button>
+    ${n>=2?`<button class="hpill tk ${tk?'hot':''}" id="bTasks">${icon('quests',18)}<b>Tasks</b>${tk?`<i class="dot">${tk}</i>`:''}</button>`:''}
+    ${n>=3?`<button class="hpill ev ${e.active?'on':''}" id="evBadge" data-t="${e.active?e.t1:e.t0}" data-a="${e.active?1:0}">${K.e}<b>${K.n}</b><em>${e.active?'ends in':'in'} ${evLeft(left)}</em></button>`:''}</div>`;}
+function homeGoal(){const NG=LEVELS.length,g=Object.keys(campOf()).length,se=starsEarned();
+  return `<button class="hmgoal v150" id="hmGoal"><span class="gl"><small>Road north</small><b>${g}/${NG} stages held</b></span><span class="gp"><i style="width:${Math.round(100*g/NG)}%"></i></span><span class="gs">★ ${se}/${NG*3}</span><em class="arr">›</em></button>`;}
+function homeSlots(){const sN=starChestsReady(),prog=starsEarned()%3,lN=lvlChestsReady(),L=accLevel();
+  const fr=freeChestReady(),fl=fr?0:(ACC.freeChestAt+86400000-Date.now());
+  const d=dailyOn()?(DAILY.st&&DAILY.seat===seatNo()?DAILY.st.login:null):null,dReady=!!(d&&d.can);
+  const ring=p=>`style="--p:${Math.round(p*100)}"`;
+  return `<div class="hmslots">
+    <button class="slot ${sN>0?'ready':''}" id="starChest" ${ring(sN>0?1:prog/3)}><small class="sl">Stars</small><span class="si">${chestSVG('iron')}</span><em>${sN>0?'OPEN':'★ '+prog+'/3'}</em>${sN>1?`<b class="cnt">×${sN}</b>`:''}</button>
+    ${lN>0?`<button class="slot ready" id="lvlChest" ${ring(1)}><small class="sl">Level</small><span class="si">${chestSVG(lvlChestTier((ACC.lvlChests||0)+2))}</span><em>OPEN</em>${lN>1?`<b class="cnt">×${lN}</b>`:''}</button>`
+      :`<button class="slot" id="lvlNext" ${ring(L.xp/L.need)}><small class="sl">Level</small><span class="si dim">${chestSVG(lvlChestTier(L.l+1))}</span><em>AT LV ${L.l+1}</em></button>`}
+    <button class="slot ${fr?'ready':''}" id="freeChest" ${ring(fr?1:1-fl/86400000)}><small class="sl">Free</small><span class="si">${chestSVG('wood')}</span><em data-until="${fr?0:ACC.freeChestAt+86400000}">${fr?'OPEN':fmtT(fl).str}</em></button>
+    <button class="slot ${dReady?'ready':''}" id="dailyGift" ${ring(dReady?1:1-msToMidnightUTC()/86400000)}><small class="sl">Gift</small><span class="si gift">${icon('gift',38)}</span><em data-midnight="${dReady?0:1}">${!dailyOn()?'DAILY':dReady?'CLAIM':fmtT(msToMidnightUTC()).str}</em></button></div>`;}
+/* the one button, and the quiet row under it: Map · what opens next · the champion */
+function homeBattleRow(){const c=CBY[ACC.sel],L=nextStage(),pu=CHAMP_ART[c.id+'_portrait'],tut=!!ACC.tut,st=campOf()[L.id]||0,again=st>0,nx=tut?homeNextOpen():null;
+  const rew=ECON.win(L,3,!again),can=!hubLocked('coll')&&typeof cardCan==='function'&&cardCan('c:'+c.id);
+  const big=tut?`<span class="bbi">${HUB_ICON.battle}</span><span class="bbt"><b>${again?'DEFEND AGAIN':'BATTLE'}</b><small>STAGE ${L.id} · ${esc(L.n)}</small></span>
+      <span class="bbr"><em>🪙 +${fmtN(rew)}</em><small>${again?'★'.repeat(st)+'<i>'+'★'.repeat(3-st)+'</i>':'up to ★★★'}</small></span>`
+    :`<span class="bbi">${HUB_ICON.battle}</span><span class="bbt"><b>BEGIN</b><small>YOUR FIRST LESSON</small></span>`;
+  return `<div class="battlerow v150"><button class="bbig go150 ${tut?'':'pulse'}" id="bBattle">${big}</button></div>
+    <div class="hmside">${hardOpen()?`<button class="bside" id="bDiffH"><span class="pe">${DIFFS[ACC.diff].e}</span>${DIFFS[ACC.diff].lbl}</button>`:`<button class="bside" id="bMapH"><span class="pe">🗺️</span>Map</button>`}
+    ${tut?`<button class="hmnew ${nx?'':'done'}" id="hmNew">${nx?`<small>Opens at stage ${nx.at}</small><b><span class="ni">${nx.e}</span>${esc(nx.n)}</b>`:`<small>All opened</small><b>⭐ Every tower and spell is yours</b>`}</button>`:''}
+    <button class="bside" id="bChampH">${pu?`<img src="${pu}" alt="">`:`<span class="pe">${c.e}</span>`}${shortName(c)}${can?'<i class="upb">⬆</i>':''}</button></div>`;}
+function hubHome(){const hh=HOUSES[ACC.house],n=obStage(),tut=!!ACC.tut,k=skinOf(),slots=tut&&n>=1;
+  const st=k==='a'?hmStageA():k==='c'?hmStageC():hmStageB();
+  return `${homeReadyRow(n)}
+    <div class="hmstage st-${k}" id="hmStage">${st}<div class="hmtitle"><b>${hh.seat}</b></div><button class="hmskin" id="bSkin" aria-label="Change the look" title="Change the look">🎨</button>${homeGoal()}</div>
+    ${homeBattleRow()}
+    ${slots?`<div class="hmslots top">${homeSlots().replace(/^<div class="hmslots">/,'').replace(/<\/div>$/,'')}</div>`:''}
+    ${tut&&n>=2?homeHold():''}
+    ${tut?homeStrip():''}
+    ${tut?'':'<div class="hint">▲ TAP BEGIN — YOUR CHAMPION WILL TEACH YOU</div>'}${ACC.refund?`<div class="hint" id="refundNote">🪙 Tower upgrades are now tower levels — ${ACC.refund} gold refunded. Army → Towers.</div>`:''}`;}
+/* one tap: the preparation sheet, or straight into the next stage (the first lesson before the tutorial) */
+function homeGo(){SFX.play('tap',80);if(!ACC.tut){startTutorial();return;}const L=nextStage();prepGo(()=>startGame({mode:'campaign',level:L}));}
+{const hb0=homeBind;homeBind=function(){hb0();
+  const on=(id,f)=>{const b=document.getElementById(id);if(b)b.addEventListener('click',f);};
+  on('bSkin',()=>{SFX.play('swipe',40);skinNext();});
+  const hero=document.getElementById('hmHero');if(hero)hero.addEventListener('click',homeStrike);
+  const map=document.getElementById('hmMap');if(map)map.addEventListener('click',()=>{SFX.play('tap',60);showCampaign();});
