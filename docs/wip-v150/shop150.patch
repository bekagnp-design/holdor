diff --git a/src/mod/shop150.css b/src/mod/shop150.css
new file mode 100644
index 0000000..92ff1a9
--- /dev/null
+++ b/src/mod/shop150.css
@@ -0,0 +1,72 @@
+/* v1.5.0 — the Shop made simple. Scoped to the Shop tab: .sitem is also used by the castle and the troops. Spacing 8 / 12 / 16, type ≥ 13 px
+   (badges 12 px), every button ≥ 44 px tall. */
+.hubbody.shop{padding:0 10px 16px}
+/* the balance, pinned on top */
+.shbal{position:sticky;top:0;z-index:6;display:flex;gap:8px;padding:8px 10px;margin:0 -10px 16px;background:linear-gradient(180deg,#0b1a2e,#0d2140);border-bottom:2px solid #1f3f6a;box-shadow:0 4px 10px rgba(0,0,0,.35)}
+.shbal .bal{flex:1;display:flex;flex-direction:column;align-items:flex-start;gap:1px;min-height:48px;background:linear-gradient(180deg,#1b4a86,#123462);border:2px solid #0b1a2e;border-radius:12px;padding:5px 10px;color:#fff;text-align:left;box-shadow:inset 0 2px 0 rgba(255,255,255,.14),0 3px 0 #06101e;font:inherit;cursor:pointer}
+.shbal .bal:active{transform:translateY(2px);box-shadow:inset 0 2px 0 rgba(255,255,255,.14),0 1px 0 #06101e}
+.shbal .bal .n{display:flex;align-items:center;gap:6px;font-family:var(--f-display);font-weight:900;font-size:17px;line-height:1.1;font-variant-numeric:tabular-nums;text-shadow:0 1px 0 #0b1a2e}
+.shbal .bal .n svg{width:20px;height:20px;filter:drop-shadow(0 1px 0 #000)}
+.shbal .bal small{font-size:13px;line-height:1.2;color:#cfe6ff;font-weight:700;text-shadow:0 1px 0 #0b1a2e}
+/* section heads */
+.hubbody.shop .hh{margin:16px 0 12px;scroll-margin-top:76px}
+.hubbody.shop .shbal+.hh{margin-top:0}
+.hubbody.shop .hh h2{font-size:17px}
+.hubbody.shop .hh small{font-size:13px}
+.hubbody.shop .hh small svg{width:15px;height:15px}
+.shtimer{display:inline-flex;align-items:center;gap:6px;background:#0c1f3a;border:2px solid #0b1a2e;border-radius:10px;padding:4px 10px;color:#ffe08a;font-family:var(--f-display);font-weight:900;font-size:13px;font-variant-numeric:tabular-nums;box-shadow:inset 0 2px 0 rgba(255,255,255,.08),0 2px 0 #06101e}
+.shtimer em{font-style:normal;color:#cfe6ff;font-family:var(--f-body);font-weight:700}
+.hubbody.shop .shopnote{margin:-4px 0 12px;font-size:13px;line-height:1.3}
+/* grids */
+.hubbody.shop .shopgrid{grid-template-columns:repeat(2,1fr);gap:16px 8px}
+.hubbody.shop .shopgrid.deals{grid-template-columns:repeat(2,1fr);gap:16px 8px}
+.hubbody.shop .shopgrid.deals.locked{grid-template-columns:repeat(3,1fr);margin-top:16px}
+.hubbody.shop .shopgrid.three{grid-template-columns:repeat(3,1fr);gap:16px 8px}
+.hubbody.shop .shopgrid+.shopgrid{margin-top:16px}
+/* one card */
+.hubbody.shop .sitem{padding:14px 8px 8px;gap:6px;border-radius:16px;border-color:var(--rc,#0b1a2e);box-shadow:inset 0 2px 0 rgba(255,255,255,.22),0 5px 0 #0b1a2e,0 0 14px color-mix(in srgb,var(--rc,#0b1a2e) 35%,transparent)}
+.hubbody.shop .sitem.wide{grid-column:1/-1}
+.hubbody.shop .sitem .ch{width:72px;height:72px;margin-top:4px}
+.hubbody.shop .sitem .dic{width:64px;height:64px;border-radius:14px}
+.hubbody.shop .sitem .dic svg{width:40px;height:40px}
+.hubbody.shop .sitem .dic .pe{font-size:34px}
+.hubbody.shop .sitem.chest .ch{width:104px;height:90px;margin-top:6px}
+.hubbody.shop .shopgrid.three .sitem{padding:14px 6px 6px}
+.hubbody.shop .shopgrid.three .sitem .ch{width:56px;height:56px}
+.hubbody.shop .shopgrid.three .sitem .dic{width:52px;height:52px}
+.hubbody.shop .shopgrid.three .sitem .dic svg{width:34px;height:34px}
+.hubbody.shop .sitem b{font-size:14px;line-height:1.15;white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-width:100%;text-overflow:clip}
+.hubbody.shop .sitem small{font-size:13px;line-height:1.3;min-height:34px;color:#dbeeff}
+.hubbody.shop .sitem.deal small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
+.hubbody.shop .shopgrid.three .sitem small{min-height:17px}
+.hubbody.shop .sitem small svg{width:13px;height:13px;vertical-align:-2px;filter:drop-shadow(0 1px 0 #000)}
+/* the buttons: green = you can, grey = what is missing, gold = Stars */
+.hubbody.shop .sitem button{width:100%;min-height:44px;font-size:14px;padding:8px 6px;gap:5px;margin-top:auto;line-height:1.1;border-radius:12px}
+.hubbody.shop .sitem button svg{width:15px;height:15px}
+.hubbody.shop .sitem button.buy,.hubbody.shop .sitem button.free{background:linear-gradient(180deg,#b6ff9a,#6fdc55 45%,#3faf2f);border-color:#1f5a17;text-shadow:0 1px 0 #1f5a17,-1px 0 0 #1f5a17,1px 0 0 #1f5a17,0 -1px 0 #1f5a17,0 2px 0 #1f5a17}
+.hubbody.shop .sitem button.stbtn.buy{background:linear-gradient(180deg,#ffe97a,#ffcf3d 45%,#f2a62c);border-color:#7a4a10;text-shadow:0 1px 0 #7a4a10,-1px 0 0 #7a4a10,1px 0 0 #7a4a10,0 -1px 0 #7a4a10,0 2px 0 #7a4a10;color:#fff}
+.hubbody.shop .sitem button:disabled{opacity:1;filter:none;background:linear-gradient(180deg,#7b8a9e,#55657a 55%,#45546a);border-color:#2a3647;color:#f2f6fb;text-shadow:0 1px 0 #2a3647,-1px 0 0 #2a3647,1px 0 0 #2a3647,0 -1px 0 #2a3647;box-shadow:inset 0 2px 0 rgba(255,255,255,.18)}
+.hubbody.shop .sitem button.need{font-size:13px;letter-spacing:0;flex-wrap:wrap;row-gap:0;padding:6px 4px}
+.hubbody.shop .sitem button.need span{white-space:normal}
+.hubbody.shop .sitem button.need span svg{display:inline-block;vertical-align:-3px;margin-left:1px}
+.hubbody.shop .sitem button.done{background:linear-gradient(180deg,#5f8f6a,#3e6b49);border-color:#1f5a17;color:#eaffea}
+/* the price tag and the badge */
+.pchip{position:absolute;top:-12px;right:8px;display:inline-flex;align-items:center;gap:4px;background:#0c1f3a;border:2px solid #0b1a2e;border-radius:9px;padding:2px 8px;font-family:var(--f-display);font-weight:900;font-size:13px;line-height:1.2;color:#fff;z-index:2;font-variant-numeric:tabular-nums;white-space:nowrap;box-shadow:0 2px 0 #06101e;text-shadow:0 1px 0 #000}
+.pchip svg{width:14px;height:14px;filter:drop-shadow(0 1px 0 #000)}
+.pchip.free{color:#b6ff9a}.pchip.star,.pchip.gold{color:#ffe08a}.pchip.gem{color:#cfe6ff}
+.hubbody.shop .sitem .badge{font-size:12px;top:-12px;left:8px;padding:2px 8px;border-radius:9px;letter-spacing:.06em;line-height:1.2;max-width:calc(100% - 16px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.hubbody.shop .sitem .badge.in{position:static;margin:auto auto 2px;max-width:100%}
+.hubbody.shop .sitem .badge.best{background:linear-gradient(180deg,#ffe97a,#f2a62c);border-color:#7a4a10;color:#3a2404;text-shadow:none}
+.hubbody.shop .shopgrid.three .sitem .pchip,.hubbody.shop .shopgrid.deals.locked .sitem .pchip{right:4px;padding:2px 6px}
+.hubbody.shop .shopgrid.three .sitem .badge,.hubbody.shop .shopgrid.deals.locked .sitem .badge{left:4px;padding:2px 6px}
+/* locked and taken */
+.hubbody.shop .sitem.lock{opacity:.8;filter:saturate(.25);background:linear-gradient(180deg,#3b4a5e,#2a3647)}
+.hubbody.shop .sitem.deal.done{opacity:.55;filter:saturate(.4)}
+.hubbody.shop .sitem.starter{background:linear-gradient(160deg,rgba(255,213,74,.2),rgba(19,40,74,.92))}
+.hubbody.shop .sitem.starter.lock{filter:none;opacity:.85}
+/* the Season Pass & VIP card */
+.hubbody.shop .shseason{margin:16px 0 0;padding:12px;gap:12px}
+.hubbody.shop .shseason .tx b{font-size:14px}
+.hubbody.shop .shseason .tx small{font-size:13px;line-height:1.3;margin-top:3px}
+.hubbody.shop .shseason .tx small svg{width:13px;height:13px;vertical-align:-2px}
+.hubbody.shop .shseason .st{font-size:14px;min-height:44px;min-width:64px;display:inline-flex;align-items:center;justify-content:center;padding:0 12px}
diff --git a/src/mod/shop150.js b/src/mod/shop150.js
new file mode 100644
index 0000000..5f256d7
--- /dev/null
+++ b/src/mod/shop150.js
@@ -0,0 +1,62 @@
+/* =========================== THE SHOP, MADE SIMPLE (v1.5.0) ===========================
+   One card for everything sold: the art in the middle, the price as one tag with its currency, and a button that says what will
+   happen — CLAIM / BUY in green when the player can pay, "Need N more <coin>" in grey when he cannot, UNLOCK for the locked picks.
+   The balance sits pinned at the top of the tab with what each currency buys. Sections, in order: For you today (the six deals and
+   the timer until the next six) · Chests · Gold for dragonglass · Dragonglass for Telegram Stars (the Starter pack first) · Season
+   Pass & VIP as one card. Every purchase path is the one from before (data-deal / data-unl / data-buy / data-xch / data-stars and
+   #bSeason are bound by hubShopBind + homeMovedBind; starsBuy opens the invoice) — only the drawing is new. */
+const SH_LOCK_SVG='<svg viewBox="0 0 24 24" fill="#c9d1da" stroke="#0b1a2e" stroke-width="1.4"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none"/><circle cx="12" cy="15.5" r="1.6" fill="#0b1a2e"/></svg>';
+/* what is missing for a price, as the grey button's content; '' when the player can pay */
+function shNeed(p){if(!p)return '';
+  if(p.gold){const n=p.gold-goldOf();return n>0?`<span>Need ${fmtN(n)} more ${GOLD_SVG}</span>`:'';}
+  if(p.gems){const n=p.gems-(ACC.gems||0);return n>0?`<span>Need ${n} more ${GEM_SVG}</span>`:'';}
+  return '';}
+/* the price tag: one chip, the currency drawn in it */
+function shChip(p){if(!p||(!p.gold&&!p.gems&&!p.stars))return '<span class="pchip free">FREE</span>';
+  if(p.stars)return `<span class="pchip star">⭐ ${p.stars}</span>`;
+  if(p.gold)return `<span class="pchip gold">${GOLD_SVG}${fmtN(p.gold)}</span>`;
+  return `<span class="pchip gem">${GEM_SVG}${p.gems}</span>`;}
+/* a buy button: green with the word when affordable, grey with what is missing when not */
+function shBuyBtn(attr,p,word){const need=shNeed(p);return need?`<button ${attr} disabled class="need">${need}</button>`:`<button ${attr} class="buy">${word||'BUY'}</button>`;}
+/* the one card: badge top-left (or, on a narrow card, under the art), price tag top-right, art, name, one line, button */
+function shCard(o){const badge=o.badge?`<span class="badge${o.badgeIn?' in':''}${o.badgeCls?' '+o.badgeCls:''}"${o.badgeCol?` style="background:${o.badgeCol}"`:''}>${o.badge}</span>`:'';
+  return `<div class="sitem sh ${o.cls||''}" style="--rc:${o.rc||'#4fb0ff'}">${o.badgeIn?'':badge}${o.chip||''}<span class="ch ${o.big?'':'dic'}">${o.art}</span><b>${o.name}</b><small>${o.line}</small>${o.badgeIn?badge:''}${o.btn}</div>`;}
+/* the balance, pinned: the two currencies and what each is for; a tap scrolls to where more of it is sold */
+function shBalance(){return `<div class="shbal"><button class="bal g" id="shBalG"><span class="n">${GOLD_SVG}${fmtN(goldOf())}</span><small>Gold · levels</small></button><button class="bal d" id="shBalD"><span class="n">${GEM_SVG}${fmtN(ACC.gems||0)}</span><small>Dragonglass · chests</small></button></div>`;}
+/* For you today: the open deals in two columns (the first one wide when their number is odd), the locked picks as a short row */
+function shDeals(){const D=dealsState(),deals=genDeals(),RC=typeof RAR_C!=='undefined'?RAR_C:['#8a97a8','#4fb0ff','#b47cff','#e3b661'];
+  const open=[],lock=[];
+  deals.forEach((d,i)=>{if(!D.unl[i]){lock.push(i);return;}
+    const bought=!!D.bought[i],free=!d.price||(!d.price.gold&&!d.price.gems),m=/\s*·\s*−(\d+)%/.exec(d.s||''),line=m?d.s.replace(m[0],''):(d.s||'');
+    const btn=bought?'<button disabled class="done">✔ TAKEN</button>':free?`<button data-deal="${i}" class="free">CLAIM</button>`:shBuyBtn(`data-deal="${i}"`,d.price);
+    open.push({cls:'deal'+(bought?' done':''),rc:RC[d.r]||RC[RC.length-1],badge:bought?'':free?'FREE':m?'−'+m[1]+'%':'',badgeCol:!free&&m?'#b33fb0':'',chip:free?'':shChip(d.price),art:d.ic,name:esc(d.n),line:esc(line),btn});});
+  if(open.length%2===1)open[0].cls+=' wide';
+  const lk=lock.map(i=>{const p={gems:ECON.unlock[i]};return shCard({cls:'deal lock',rc:'#5a6c85',chip:shChip(p),art:SH_LOCK_SVG,name:`Deal ${i+1}`,line:i===5?'The last pick · locked':`A ${i+1}th pick · locked`,btn:shBuyBtn(`data-unl="${i}"`,p,'UNLOCK')});}).join('');
+  const dt=fmtT(msToDeals());
+  return `<div class="hh"><h2>For you today</h2><span class="shtimer"><em>new in</em><b id="dealCd">${dt.h}:${dt.m}:${dt.s}</b></span></div>
+  <div class="shopgrid deals">${open.map(shCard).join('')}</div>${lk?`<div class="shopgrid deals locked">${lk}</div>`:''}`;}
+/* Chests: the four tiers, the rarity in its colour, what is inside as one line */
+function shChests(){const free=freeChestReady(),ft=fmtT(86400000-(Date.now()-(ACC.freeChestAt||0)));
+  const cards=['wood','iron','valyrian','dragon'].map(t=>{const T=CHEST_TIERS[t];
+    const line=`<i style="color:${T.trim};font-style:normal;font-weight:900">${T.sub}</i> · ${T.gold[0]}–${T.gold[1]} ${GOLD_SVG} · ${T.gems[0]}–${T.gems[1]} ${GEM_SVG} · ${T.cards} card stack${T.cards>1?'s':''}${T.rare?` (${T.rare} rare+)`:''}`;
+    const btn=t==='wood'?(free?'<button class="free" data-buy="wood">OPEN</button>':`<button data-buy="wood" disabled class="need"><span>Free in ${ft.str}</span></button>`):shBuyBtn(`data-buy="${t}"`,{gems:T.price});
+    return shCard({cls:'chest',big:1,rc:T.trim,badge:t==='wood'?(free?'DAILY FREE':'DAILY'):'',badgeCol:t==='wood'&&!free?'#5a6c85':'',chip:t==='wood'?'':shChip({gems:T.price}),art:chestSVG(t),name:T.n,line,btn});}).join('');
+  return `<div class="hh"><h2>Chests</h2><small>gold, dragonglass and cards</small></div><div class="shopgrid">${cards}</div>`;}
+/* Gold for dragonglass: three purses, the best rate marked */
+function shExchange(){const X=ECON.exchange,best=X.reduce((b,x,i)=>x[1]/x[0]>X[b][1]/X[b][0]?i:b,0);
+  return `<div class="hh" id="shXch"><h2>Gold for dragonglass</h2><small>${GEM_SVG} → ${GOLD_SVG}</small></div><div class="shopgrid three">${X.map(([g,gd],i)=>shCard({rc:'#e3b661',badge:i===best?'BEST VALUE':'',badgeIn:1,badgeCls:'best',chip:shChip({gems:g}),art:GOLD_SVG,name:`+${fmtN(gd)}`,line:['Purse','Chest','Hoard'][i]+' of gold',btn:shBuyBtn(`data-xch="${i}"`,{gems:g})})).join('')}</div>`;}
+/* Dragonglass for Telegram Stars: the Starter pack first when the seat still has it, then the three packs; grey with the reason when
+   this seat cannot pay (a guest, or an old Telegram) */
+function shStars(){if(ecoOn())starsShopLoad();const can=starsCan();
+  const note=can?'':`<p class="shopnote">${ecoOn()?'Open the game in an up-to-date Telegram to pay with Stars.':'Payments work on a seat signed in through Telegram — the server credits it.'}</p>`;
+  const keys=['gems_s','gems_m','gems_l'],best=keys.reduce((b,k)=>STARS_SHOP[k].gems/STARS_SHOP[k].stars>STARS_SHOP[b].gems/STARS_SHOP[b].stars?k:b,keys[0]);
+  const pack=(k,big)=>{const S=STARS_SHOP[k];const btn=can?`<button class="stbtn buy" data-stars="${k}">BUY</button>`:`<button class="stbtn" data-stars="${k}" disabled>${big?'TELEGRAM ONLY':'LOCKED'}</button>`;
+    return shCard({cls:(k==='starter'?'starter wide':'')+(can?'':' lock'),rc:k==='starter'?'#ffd54a':'#4fb0ff',badge:k==='starter'?'ONCE · BEST VALUE':k===best?'BEST VALUE':'',badgeIn:k!=='starter',badgeCls:'best',chip:shChip({stars:S.stars}),art:GEM_SVG,name:k==='starter'?'Starter pack':`+${S.gems}`,line:k==='starter'?`${S.gems} ${GEM_SVG} · ${fmtN(S.gold)} ${GOLD_SVG} · 3 Rare books`:'dragonglass',btn});};
+  const starter=ecoOn()&&STARS.starter===false?`<div class="shopgrid">${pack('starter',1)}</div>`:'';
+  return `<div class="hh" id="shStars"><h2>Dragonglass</h2><small>pay with Telegram Stars ⭐</small></div>${note}${starter}<div class="shopgrid three">${keys.map(k=>pack(k)).join('')}</div>`;}
+/* Season Pass & VIP: one card, one button (the page holds both purchases) */
+function shSeason(){const on=typeof seasonOn==='function'&&seasonOn(),P=STARS_SHOP.pass,V=STARS_SHOP.vip;
+  return `<button class="evcard live wide shseason" id="bSeason"><span class="ic">${icon('season',30)}</span><span class="tx"><b>Season Pass &amp; VIP</b><small>Pass ⭐${P.stars} · premium rewards on every tier. VIP ⭐${V.stars} · 25 ${GEM_SVG} a day for ${V.days} days${on?'':'. Needs a Telegram seat'}</small></span><span class="st">OPEN</span></button>`;}
+function shop150HTML(){return shBalance()+shDeals()+shChests()+shExchange()+shStars()+shSeason();}
+function shop150Bind(){const go=(id,sel)=>{const b=document.getElementById(id);if(b)b.addEventListener('click',()=>{SFX.play('tap',50);const t=document.querySelector(sel);if(t)t.scrollIntoView({behavior:'smooth',block:'start'});});};
+  go('shBalG','#shXch');go('shBalD','#shStars');}
diff --git a/src/parts/98zc_shop.py b/src/parts/98zc_shop.py
new file mode 100644
index 0000000..60db67b
--- /dev/null
+++ b/src/parts/98zc_shop.py
@@ -0,0 +1,9 @@
+# v1.5.0 — the Shop made simple: one card style, the price as one tag with its currency, a green CLAIM / BUY when the player can pay
+# and a grey "Need N more" when he cannot, the locked picks as a short row, the balance pinned on top with what each currency buys;
+# sections: For you today (deals + timer) · Chests · Gold for dragonglass · Dragonglass for Stars (Starter pack first) · Season Pass & VIP
+# as one card. src/mod/shop150.js + shop150.css. hubShopBind, starsBuy and every data-* purchase path are unchanged; hubShopV1 keeps the old drawing.
+rep("function hubShop(){const free=freeChestReady()", "function hubShop(){return shop150HTML();}\nfunction hubShopV1(){const free=freeChestReady()", 1, 'shop150-hub')
+rep("function hubShopBind(){homeMovedBind();", "function hubShopBind(){homeMovedBind();shop150Bind();", 1, 'shop150-bind')
+i = s.find('window.HOLDOR={'); assert i > 0, 'exports anchor'
+s = s[:i] + mod('shop150.js').rstrip('\n') + '\n' + s[i:]
+rep("\n</style>\n</head>", "\n" + mod('shop150.css').rstrip('\n') + "\n</style>\n</head>", 1, 'shop150-css')
