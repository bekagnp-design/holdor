+++ b/src/parts/98zz_ui150.py
@@ -0,0 +1,6 @@
+# v1.5.0 — ui150: one system for the menus. Tokens on :root (--ok, --gold-hi, --blue-hi, --card, --r-md, --tap …), roles
+# (gold = play/buy, green = ready/free, blue = back/navigation, quiet = toggles, red outline = destructive, one grey for disabled),
+# every menu button at least 44 px with 8 px between neighbours, one type scale (23/18/15/13/11). CSS only, applied last, scoped to
+# #card / #dkSheet / #ecoModal; the battle HUD, films, the chest scene, the preparation sheet, the result card, the book, the parchment
+# and the bottom bar keep their own looks. src/mod/ui150.css
+rep("\n</style>\n</head>", "\n" + mod('ui150.css').rstrip('\n') + "\n</style>\n</head>", 1, 'ui150-css')
diff --git a/tests/audit_ui150.js b/tests/audit_ui150.js
