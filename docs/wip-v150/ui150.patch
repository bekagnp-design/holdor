+++ b/tests/audit_ui150.js
@@ -0,0 +1,47 @@
+// UI audit for v1.5.0 (ui150): opens the main menu screens at 390×844, screenshots each into .shots/ui150/<tag>_<screen>.png and
+// lists every visible menu <button> (inside #card, not the battle HUD) whose height is under 44 px. usage: node tests/audit_ui150.js before|after
+const { chromium } = require('playwright');
+const path = require('path'), fs = require('fs');
+const TAG = process.argv[2] || 'now';
+const SC = path.resolve(__dirname, '..', '.shots', 'ui150') + '/'; fs.mkdirSync(SC, { recursive: true });
+const URL = 'file://' + path.resolve(__dirname, '..', process.env.HOLDOR_HTML || 'beta/index.html');
+const SCREENS = [
+  ['home', `H.showHub('battle')`], ['shop', `H.showHub('shop')`], ['heroes', `H.showHub('coll','heroes')`], ['towers', `H.showHub('coll','towers')`],
+  ['spells', `H.showHub('coll','spells')`], ['deck', `H.showHub('coll','deck')`], ['heroroom', `window.HOLDOR_ARMY.showHeroRoom('robb')`],
+  ['towerroom', `window.HOLDOR_ARMY.showTowerRoom('archer')`], ['spellroom', `window.HOLDOR_CARDS.showSpellRoom('arrows')`],
+  ['trials', `H.showHub('trials')`], ['tasks', `H.showHub('tasks')`], ['hold', `H.showHub('hold')`], ['events', `H.showHub('events')`], ['clan', `H.showHub('clan')`],
+  ['forge', `H.showHub('coll','heroes');setTimeout(()=>document.getElementById('bForge').click(),80)`], ['tavern', `H.showHub('coll','heroes');setTimeout(()=>document.getElementById('bTavern').click(),80)`],
+  ['city', `H.showHub('coll','heroes');setTimeout(()=>document.getElementById('bCity').click(),80)`], ['season', `H.showHub('shop');setTimeout(()=>document.getElementById('bSeason').click(),80)`],
+  ['holdmore', `H.showHub('battle');setTimeout(()=>document.getElementById('bHoldMore').click(),80)`],
+];
+(async () => {
+  const browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined });
+  const page = await browser.newPage({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 2, hasTouch: true });
+  const errors = []; page.on('pageerror', e => errors.push('PE:' + e.message));
+  await page.goto(URL); await page.waitForFunction(() => window.HOLDOR && window.HOLDOR_HOME98 && window.HOLDOR_DECK, { timeout: 20000 }); await page.waitForTimeout(300);
+  await page.evaluate(() => { const H = window.HOLDOR; const a = H.newAccount('stark', 0, 'squire'); a.intro = 1; a.tut = 1; a.tour = 99;
+    a.tours = { win: 1, battle: 1, coll: 1, shop: 1, hold: 1, events: 1, tasks: 1 }; a.learn = { chest: 1, hold: 1, champ: 1, glass: 1, keep: 1, tier2: 1, fire: 1 };
+    for (let i = 1; i <= 28; i++) a.campaign[i] = 3; a.freeChestAt = Date.now() - 3600000; a.holdTut = 1; a.holdIntro = 1; a.gold = 9000; a.gems = 160; a.sel = 'robb';
+    a.cards = { 'c:robb': 200, 'b:c': 2, 's:arrows': 9, 't:archer': 30 }; a.rv = a.rv || {}; a.ui = a.ui || {}; H.setAcc(a); H.persist(); H.showHub('battle'); });
+  await page.waitForTimeout(600);
+  const out = {};
+  for (const [name, code] of SCREENS) {
+    await page.evaluate((c) => { const H = window.HOLDOR; try { eval(c); } catch (e) { console.log('nav fail', c, e.message); } }, code);
+    await page.waitForTimeout(700);
+    const r = await page.evaluate(() => {
+      const card = document.getElementById('card'); if (!card) return { none: true };
+      const vis = (el) => { if (el.offsetWidth < 2 || el.offsetHeight < 2) return false; const cs = getComputedStyle(el); return cs.visibility !== 'hidden' && cs.display !== 'none' && +cs.opacity > 0.05 && !el.closest('[hidden]'); };
+      const btns = [...card.querySelectorAll('button')].filter(vis);
+      const desc = (b) => { const r = { height: b.offsetHeight, width: b.offsetWidth }; return { h: Math.round(r.height), w: Math.round(r.width), id: b.id || '', cls: b.className || '', tx: (b.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 28), par: (b.parentElement.className || b.parentElement.id || '').toString().slice(0, 30) }; };
+      const small = btns.filter(b => b.offsetHeight < 44).map(desc);
+      const wrap = card.firstElementChild ? card.firstElementChild.className : '';
+      return { total: btns.length, small, wrap, screen: window.HOLDOR.CLOUD.screen, scrollH: card.scrollHeight };
+    });
+    out[name] = r;
+    await page.screenshot({ path: SC + TAG + '_' + name + '.png' });
+  }
+  fs.writeFileSync(SC + TAG + '_audit.json', JSON.stringify(out, null, 1));
+  for (const [k, v] of Object.entries(out)) { console.log(`## ${k} [${v.screen}] wrap=${v.wrap} buttons=${v.total} small=${v.small ? v.small.length : '-'}`); (v.small || []).forEach(s => console.log(`   ${s.h}x${s.w} #${s.id} .${s.cls} "${s.tx}" <${s.par}>`)); }
+  if (errors.length) console.log('ERRORS', errors.join('\n'));
+  await browser.close();
+})();
