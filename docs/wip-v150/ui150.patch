diff --git a/src/mod/ui150.css b/src/mod/ui150.css
new file mode 100644
index 0000000..cc4ae13
--- /dev/null
+++ b/src/mod/ui150.css
@@ -0,0 +1,66 @@
+/* ===== v1.5.0 · ui150 — one system for the menus: tokens, roles, touch targets. Applied last, by role, scoped to the menus
+   (#card, #dkSheet, #ecoModal). Left alone on purpose: the battle HUD (#hud, #sheet, #clashUi, #boonOv), the films (.card.full,
+   .fs, .film), the chest scene (#cer), the preparation sheet (#prep), the result card (.card.res), the book (.bookfs, .bk*),
+   the parchment (.hdet), the bottom bar (.hubtabs), the home's BATTLE! / MAP / champion buttons (.bbig, .bside) and the chest slots. ===== */
+:root{--ok:#8be26a;--ok-deep:#3f9a3a;--ok-bd:#1f5a17;--ok-ink:#0b2a0a;
+  --gold-hi:#ffe97a;--gold-mid:#ffcf3d;--gold-deep:#f2a62c;--gold-bd:#7a4a10;--gold-ink:#2a1a05;
+  --warn:#e14b4b;--warn-deep:#8a1d1d;--lock:#8a97a8;--lock-deep:#59687b;
+  --blue-hi:#2a6fb9;--blue-deep:#1a4d8c;--blue-bd:#0b1a2e;
+  --card:#13284a;--card-bd:#0b1a2e;--quiet:rgba(255,255,255,.06);--quiet-bd:rgba(255,255,255,.16);
+  --r-sm:9px;--r-md:12px;--r-lg:16px;--tap:44px;--gap:8px}
+
+/* --- touch targets: every menu button is at least 44 px tall; rows of buttons keep 8 px between neighbours --- */
+:is(#card,#dkSheet) button:not(:where(.hubtabs button,.bbig,.bside,.slot,.hpill,.ic,.hmlink,.linkbtn,.bookfs button,.bktiers button,.bkpager button,.card.full button,.fs button,.film button,.res button)),
+#ecoModal .eb button{min-height:var(--tap)}
+:where(#card) :is(.row,.acts,.minirow,.resrow,.tvfoot,.clrow,.dbtns,.cfoot,.lvline,.skrh,.subtabs){gap:var(--gap)}
+:where(#card) .subtabs button{white-space:nowrap;padding-left:2px;padding-right:2px}
+#ecoModal .eb{gap:var(--gap)}
+:where(#card) .hmhold .hmlink{min-height:40px;display:flex;align-items:center;gap:6px}
+:where(#card) .linkbtn{min-height:40px;padding:10px 8px}
+:where(#card) .hpill{height:40px;border-radius:20px}
+:where(#card) .hmgoal{min-height:var(--tap)}
+:where(#card) :is(.topbar .back,.hback button){min-width:var(--tap);min-height:var(--tap);padding:0 14px;display:inline-flex;align-items:center;justify-content:center;gap:4px}
+:where(#card) .topbar .back{padding:0;font-size:18px;line-height:1}
+
+/* --- primary, gold: play / buy / open / go (costs something or starts something) --- */
+:where(#card,#dkSheet) :is(.btn:not(.sec):not(.nextbig):not(.danger),.sitem button:not(.free):not(.stbtn),.hmhold .hmgo.go,.qrow button.go,.playcard .go,.mapcard .go,.mapcard2 .go,.bigbtn.max,.chbar .go,.stbtn:not(:disabled),.trgo):not(:where(.res *,.hdet *,.bookfs *)),
+#ecoModal .eb button:not(.sec){background:linear-gradient(180deg,var(--gold-hi),var(--gold-mid) 45%,var(--gold-deep));border:3px solid var(--gold-bd);border-bottom-width:5px;border-radius:var(--r-md);color:var(--gold-ink);text-shadow:none;font-family:var(--f-display);font-weight:900;letter-spacing:.04em}
+:where(#card) .hmhold .hmgo.go{border-radius:var(--r-lg)}
+:where(#card) .sitem button:active{transform:translateY(2px);border-bottom-width:3px}
+
+/* --- ready, green: free / claim / level up now (costs nothing, waits for one tap) --- */
+:where(#card,#dkSheet) :is(.bigbtn.lvl.ready,.skr .skrh button.go,.sitem button.free,.qrow button.claim,.btn.ok,.btn.free,.btn.claim):not(:where(.res *,.hdet *)){background:linear-gradient(180deg,var(--ok),var(--ok-deep));border:3px solid var(--ok-bd);border-bottom-width:5px;color:var(--ok-ink);text-shadow:none;font-family:var(--f-display);font-weight:900;letter-spacing:.04em}
+:where(#card) .qrow button.claim{box-shadow:0 0 16px rgba(139,226,106,.45);border-radius:var(--r-lg)}
+:where(#card,#dkSheet) .bigbtn.lvl.ready{border-radius:var(--r-lg)}
+:where(#card) :is(.sitem .badge,.ccard .upb,.ccard .cb.ok i,.ccard.dkc .dkin,.hubtop .cur .plus,.slot.ready em){background:linear-gradient(180deg,var(--ok),var(--ok-deep));border-color:var(--ok-bd)}
+:where(#card) .slot.ready em{color:var(--ok-ink)}
+
+/* --- secondary, blue: back / navigation / the quieter of two choices --- */
+:where(#card,#dkSheet) :is(.hback button,.btn.sec:not(.danger),.bigbtn.ride:not(.on):not(:disabled),.topbar .back,.dkban button):not(:where(.res *,.hdet *)),
+#ecoModal .eb button.sec{background:linear-gradient(180deg,var(--blue-hi),var(--blue-deep));border:3px solid var(--blue-bd);border-bottom-width:5px;border-radius:var(--r-md);color:#fff;text-shadow:0 1px 0 var(--blue-bd);font-family:var(--f-display);font-weight:900;letter-spacing:.03em;box-shadow:none}
+:where(#card) .hback button{font-size:13px}
+
+/* --- quiet outline: toggles, folded sections, a button that is not ready yet, small choices in a list --- */
+:where(#card) :is(.tgl,.bigbtn.lvl.need,.bigbtn.ride.on,.bigbtn.ride:disabled,.skr .skrh button:not(.go),.ccard button,.row button,.shop .it button,.artsheet .it button,.minirow button,.champ .acts button,.sk button,.tvfoot button,.langgrid button,.tabs button:not(.on)):not(:where(.res *,.hdet *)){background:var(--quiet);border:1px solid var(--quiet-bd);border-radius:var(--r-md);font-family:var(--f-display);font-weight:700}
+:where(#card) :is(.tvfoot button,.row button,.champ .acts button,.langgrid button){color:var(--ink);font-size:13px}
+
+/* --- destructive: delete / sell / burn — a warm red outline, never a filled button --- */
+:where(#card) :is(.btn.danger,button.danger,#bYes){background:rgba(225,75,75,.12);border:2px solid var(--warn);color:#ffb4a8;text-shadow:none;font-family:var(--f-display);font-weight:900}
+
+/* --- disabled / locked: one grey, no stacked filters, no glow, no pulse --- */
+:is(#card,#dkSheet) button:disabled:not(:where(.ride,.max,.need,.hmgo,.on,.bookfs button,.bkpager button,.res button)),#ecoModal .eb button:disabled{opacity:.55;filter:grayscale(.6);box-shadow:none;animation:none;transform:none;cursor:default}
+#card :is(.lock,.locked,.sitem.lock) button:disabled{opacity:1;filter:none}
+
+/* --- gold chips (live, tag, max) share the gold --- */
+:where(#card) :is(.evcard.live .st,.ccard .tag,.ccard .cb.max i,.subtabs button.on){background:linear-gradient(180deg,var(--gold-hi),var(--gold-deep))}
+
+/* --- cards: one frame --- */
+:where(#card) .trcard{border:3px solid var(--card-bd);box-shadow:0 4px 0 var(--card-bd);border-radius:var(--r-lg)}
+
+/* --- type scale for the menus: 23 (page) / 18 (section) / 15 (card) / 13 (label) / 11 (caption) --- */
+:where(#card) :is(.card:not(.res):not(.full) h1,.topbar h1,.hname b){font:900 23px/1.1 var(--f-display);letter-spacing:.03em}
+:where(#card) :is(.hh h2,.trcard .trtx b,.mapcard h2,.mapcard2 h2,.soon h2,.playcard h2){font-size:18px}
+#ecoModal h3{font-size:18px}
+:where(#card) :is(.card h2,.tksec h3,.statbox .hd b,.slot .b .nm,.hmhold .hmtx b){font-size:15px}
+:where(#card) :is(.sitem small,.hcard small,.hpill small,.armybox small,.clcard .cltx small,.evcard.wide .tx small,.trcard .trtx small){font-size:11px}
+:where(#card) :is(.shopgrid.three .sitem small,.sitem.deal small,.rrow .pp small,.gitem small,.gpk small,.smc small,.clbots .clb small,.chm .cb small){font-size:10.5px}
diff --git a/src/parts/98zz_ui150.py b/src/parts/98zz_ui150.py
