+// Style census for v1.5.0 (ui150): opens the menu screens and counts DISTINCT computed styles per role — buttons by background
+// (gold / green / blue / grey-quiet / other), back buttons, disabled buttons, headings and captions by font-size, cards by frame.
+// usage: HOLDOR_HTML=<file> node tests/census_ui150.js
+const { chromium } = require('playwright');
+const path = require('path');
+const URL = 'file://' + path.resolve(__dirname, '..', process.env.HOLDOR_HTML || 'beta/index.html');
+const SCREENS = [`H.showHub('battle')`, `H.showHub('shop')`, `H.showHub('coll','heroes')`, `H.showHub('coll','towers')`, `H.showHub('coll','spells')`, `H.showHub('coll','deck')`,
+  `window.HOLDOR_ARMY.showHeroRoom('robb')`, `window.HOLDOR_ARMY.showTowerRoom('archer')`, `window.HOLDOR_CARDS.showSpellRoom('arrows')`, `H.showHub('trials')`, `H.showHub('tasks')`,
+  `H.showHub('hold')`, `H.showHub('events')`, `H.showHub('clan')`, `H.showHub('coll','heroes');setTimeout(()=>document.getElementById('bCity').click(),80)`, `H.showHub('shop');setTimeout(()=>document.getElementById('bSeason').click(),80)`];
+(async () => {
+  const browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined });
+  const page = await browser.newPage({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 1, hasTouch: true });
+  await page.goto(URL); await page.waitForFunction(() => window.HOLDOR && window.HOLDOR_HOME98 && window.HOLDOR_DECK, { timeout: 20000 }); await page.waitForTimeout(300);
+  await page.evaluate(() => { const H = window.HOLDOR; const a = H.newAccount('stark', 0, 'squire'); a.intro = 1; a.tut = 1; a.tour = 99;
+    a.tours = { win: 1, battle: 1, coll: 1, shop: 1, hold: 1, events: 1, tasks: 1 }; a.learn = { chest: 1, hold: 1, champ: 1, glass: 1, keep: 1, tier2: 1, fire: 1 };
+    for (let i = 1; i <= 28; i++) a.campaign[i] = 3; a.freeChestAt = Date.now() - 3600000; a.holdTut = 1; a.holdIntro = 1; a.gold = 9000; a.gems = 160; a.sel = 'robb';
+    a.cards = { 'c:robb': 200, 'b:c': 2, 's:arrows': 9, 't:archer': 30 }; H.setAcc(a); H.persist(); H.showHub('battle'); });
+  await page.waitForTimeout(500);
+  const acc = { gold: new Set(), green: new Set(), blue: new Set(), quiet: new Set(), other: new Set(), back: new Set(), disabled: new Set(), h1: new Set(), h2: new Set(), h3: new Set(), small: new Set(), cards: new Set(), radii: new Set() };
+  for (const code of SCREENS) {
+    await page.evaluate((c) => { const H = window.HOLDOR; try { eval(c); } catch (e) {} }, code); await page.waitForTimeout(600);
+    const r = await page.evaluate(() => {
+      const card = document.getElementById('card'); const out = { gold: [], green: [], blue: [], quiet: [], other: [], back: [], disabled: [], h1: [], h2: [], h3: [], small: [], cards: [], radii: [] };
+      const vis = (el) => el.offsetWidth > 1 && el.offsetHeight > 1 && !el.closest('[hidden]') && getComputedStyle(el).visibility !== 'hidden';
+      const rgb = (s) => (s.match(/rgba?\([^)]*\)/g) || []).map(c => c.match(/\d+(\.\d+)?/g).slice(0, 3).map(Number));
+      const hue = ([r, g, b]) => { const mx = Math.max(r, g, b), mn = Math.min(r, g, b); if (mx === mn) return -1; let h; if (mx === r) h = (g - b) / (mx - mn); else if (mx === g) h = 2 + (b - r) / (mx - mn); else h = 4 + (r - g) / (mx - mn); return ((h * 60) + 360) % 360; };
+      const sat = ([r, g, b]) => { const mx = Math.max(r, g, b), mn = Math.min(r, g, b); return mx ? (mx - mn) / mx : 0; };
+      for (const b of card.querySelectorAll('button')) {
+        if (!vis(b) || b.closest('.hubtabs') || b.classList.contains('bbig') || b.classList.contains('bside') || b.classList.contains('slot') || b.closest('.hdet')) continue;
+        const cs = getComputedStyle(b); const bg = cs.backgroundImage !== 'none' ? cs.backgroundImage : cs.backgroundColor; const key = bg + ' | ' + cs.borderTopColor + ' ' + cs.borderTopWidth + ' | ' + cs.color;
+        out.radii.push(cs.borderTopLeftRadius);
+        if (b.disabled) { out.disabled.push(cs.opacity + ' ' + cs.filter); continue; }
+        if (b.classList.contains('back') || b.id === 'hubBack' || b.id === 'bBack') { out.back.push(key + ' ' + b.offsetWidth + 'x' + b.offsetHeight); continue; }
+        const cols = rgb(bg); const main = cols.find(c => sat(c) > .25) || cols[0] || [0, 0, 0]; const h = hue(main), s = sat(main);
+        if (s < .2 || main.length === 0) out.quiet.push(key); else if (h >= 35 && h <= 60) out.gold.push(key); else if (h > 70 && h <= 160) out.green.push(key); else if (h > 190 && h <= 240) out.blue.push(key); else out.other.push(key);
+      }
+      for (const h of card.querySelectorAll('h1, .hname b, .topbar h1')) if (vis(h) && !h.closest('.res')) out.h1.push(getComputedStyle(h).fontSize + ' ' + getComputedStyle(h).fontWeight);
+      for (const h of card.querySelectorAll('h2, .trcard .trtx b, .holdhead b')) if (vis(h)) out.h2.push(getComputedStyle(h).fontSize + ' ' + getComputedStyle(h).fontWeight);
+      for (const h of card.querySelectorAll('h3, .statbox .hd b, .slot .b .nm')) if (vis(h)) out.h3.push(getComputedStyle(h).fontSize + ' ' + getComputedStyle(h).fontWeight);
+      for (const s of card.querySelectorAll('small')) if (vis(s) && !s.closest('.hubtabs')) out.small.push(getComputedStyle(s).fontSize);
+      for (const c of card.querySelectorAll('.sitem, .evcard, .clcard, .trcard, .hpanel, .hmhold, .qrow, .statbox, .ccard')) if (vis(c)) { const cs = getComputedStyle(c); out.cards.push(cs.borderTopWidth + ' ' + cs.borderTopColor + ' r' + cs.borderTopLeftRadius); }
+      return out; });
+    for (const k of Object.keys(acc)) r[k].forEach(v => acc[k].add(v));
+  }
+  const line = (k, label) => console.log(`${label}: ${acc[k].size}` + (acc[k].size && acc[k].size <= 14 ? '  ' + [...acc[k]].map(v => v.length > 120 ? v.slice(0, 120) + '…' : v).join(' ‖ ') : ''));
+  line('gold', 'gold buttons · distinct'); line('green', 'green buttons · distinct'); line('blue', 'blue buttons · distinct'); line('quiet', 'quiet/grey buttons · distinct'); line('other', 'other-colour buttons · distinct');
+  line('back', 'back buttons · distinct'); line('disabled', 'disabled buttons · distinct opacity/filter'); line('radii', 'button radii · distinct');
+  line('h1', 'h1 (page title) sizes'); line('h2', 'h2 (section) sizes'); line('h3', 'h3 (card) sizes'); line('small', 'caption sizes'); line('cards', 'card frames · distinct');
+  await browser.close();
+})();
diff --git a/tests/t_ui150.js b/tests/t_ui150.js
