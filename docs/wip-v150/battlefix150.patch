+/* battle-screen fixes.
+   · The CALL WAVE button keeps off the build pads: per stage it takes the first free spot of bottom-left, bottom-right,
+     then one row higher on either side (the default spot when none is free); it hides while a build ring is open, because
+     the ring's buttons would sit under it. Placed once per stage and canvas size (CALLP.key).
+   · The champion's speech bubble is not drawn while a ring is open; the new-enemy toast draws its name left-aligned after
+     the icon (both patched in place by src/parts/98zc_battlefix.py). */
+const CALLP={key:null,pick:null};
+const CALL_SPOTS=[[10,null,108],[null,10,108],[10,null,170],[null,10,170]];
+function callBtnPlace(b){
+  const st=document.getElementById('stage');if(!b||!st||typeof G==='undefined'||!G||!G.map||typeof w2s!=='function')return;
+  const sw=st.clientWidth,sh=st.clientHeight;
+  const key=[G.level?G.level.id:G.mode,G.map.slots.length,sw,sh,Math.round(CAM.z*100),Math.round(CAM.x),Math.round(CAM.y)].join(':');
+  if(CALLP.key===key)return;
+  const bw=Math.max(b.offsetWidth||0,182),bh=b.offsetHeight||46,R=24*scale*CAM.z+6;
+  const free=(l,r,bt)=>{const x0=l!=null?l:sw-r-bw,x1=x0+bw,y1=sh-bt,y0=y1-bh;
+    for(const s of G.map.slots){const p=w2s(s.x,s.y);if(p.x+R>x0&&p.x-R<x1&&p.y+R>y0&&p.y-R<y1)return false;}return true;};
+  const pick=CALL_SPOTS.find(c=>free(...c))||CALL_SPOTS[0];
+  CALLP.key=key;CALLP.pick=pick;CALLP.last={bw,bh,R,sw,sh,sc:scale,pads:G.map.slots.map(s=>{const p=w2s(s.x,s.y);return [Math.round(p.x),Math.round(p.y)];})};
+  b.style.left=pick[0]!=null?pick[0]+'px':'auto';b.style.right=pick[1]!=null?pick[1]+'px':'auto';b.style.bottom=pick[2]+'px';}
diff --git a/src/parts/98zc_battlefix.py b/src/parts/98zc_battlefix.py
